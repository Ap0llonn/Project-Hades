{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ES2020", "DOM", "DOM.Iterable"],
        "types": ["vite/client"],
        "allowJs": true,
        "checkJs": false,
        "isolatedModules": true,
        "noEmit": true,
        "skipLibCheck": true
    },
    "include": ["resources/js/**/*", "vite.config.js"]
}
